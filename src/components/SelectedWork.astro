---
// Selected Work section. Figma: Selected Work 126:6804.
// padding 40px 100px; inner 1240px; two project cards with 48px gap.
import ProjectCard from './ProjectCard.astro';
import { withBase } from '../lib/base';
---

<section class="selected-work" data-fidelity="selected-work">
  <div class="selected-work__inner">
    <ProjectCard
      eyebrow="MOBILE APPLICATION · PARENTING"
      title="Baby Boost"
      description="A parenting app that turns everyday moments into guided developmental activities, milestone tracking, and memory-keeping — built with an AI-generated illustration system."
      href={withBase('/work/baby-boost')}
      cover={withBase('/assets/work-baby-boost-cover.png')}
      coverAlt="Baby Boost — two phones showing the parenting app on a lavender background"
    />
    <ProjectCard
      reverse
      eyebrow="WEB & MOBILE APPLICATION · B2B PLATFORM"
      title="Smart Stock"
      description={'An integrated inventory, supplier ordering, and POS platform for small and medium-sized businesses,<br>with an AI assistant that optimizes purchasing decisions in real time.'}
      href={withBase('/work/smart-stock')}
      cover={withBase('/assets/work-pharmacare-cover.png')}
      coverAlt="Smart Stock — inventory management dashboard on a light-blue background"
    />
  </div>
</section>

<style>
  .selected-work { padding: 40px 100px; }
  .selected-work__inner {
    width: 1240px;
    max-width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  @media (max-width: 1040px) {
    .selected-work { padding: 40px clamp(20px, 5vw, 100px); }
    .selected-work__inner { width: 100%; }
  }
</style>
