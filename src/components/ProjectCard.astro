---
// Selected-work project card. Figma: Project Card 126:6806 / 126:6814.
// content col (600) + cover (450), space-between. `reverse` puts the cover left.
interface Props {
  eyebrow: string;
  title: string;
  /** may contain <br> for explicit line breaks matching the design */
  description: string;
  href: string;
  cover: string;
  coverAlt: string;
  reverse?: boolean;
}
const { eyebrow, title, description, href, cover, coverAlt, reverse = false } = Astro.props;
---

<article class="card" class:list={[{ 'card--reverse': reverse }]} data-reveal>
  <div class="card__content">
    <p class="card__eyebrow">{eyebrow}</p>
    <h3 class="card__title">{title}</h3>
    <p class="card__desc" set:html={description}></p>
    <a class="view-btn" href={href}>
      <span class="view-btn__label">View Case Study</span>
      <svg class="view-btn__arrow" viewBox="0 0 16.254 12.503" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <g fill="#5A6573">
          <path d="M10 12.503a.626.626 0 0 1-.444-1.07l5.188-5.18L9.556 1.07a.628.628 0 0 1 .888-.887l5.625 5.625a.626.626 0 0 1 0 .887l-5.625 5.625a.63.63 0 0 1-.444.182"/>
          <path d="M15.625 6.878h-15a.625.625 0 0 1 0-1.25h15a.625.625 0 1 1 0 1.25"/>
        </g>
      </svg>
    </a>
  </div>
  <a class="card__cover" href={href} aria-label={`View case study: ${title}`}>
    <img src={cover} alt={coverAlt} width="450" height="371" loading="eager" />
  </a>
</article>

<style>
  .card {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: stretch;
    width: 1240px;
    max-width: 100%;
    height: 370.588px;
  }
  .card--reverse { flex-direction: row-reverse; }

  .card__content {
    width: 600px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
  }

  .card__eyebrow {
    font-weight: 600;
    font-size: 12px;
    line-height: 1.3;
    letter-spacing: 1.2px;
    color: var(--color-accent);
  }
  .card__title {
    font-weight: 600;
    font-size: 40px;
    line-height: 1.15;
    letter-spacing: -0.5px;
    color: var(--color-text-primary);
  }
  .card__desc {
    font-weight: 400;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .view-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    color: var(--color-grey);
    font-size: 18px;
    line-height: 1.2;
  }
  .view-btn__label {
    padding-bottom: 3px;
    border-bottom: 1.5px solid var(--color-grey);
  }
  .view-btn__arrow {
    width: 16.25px;
    height: 12.5px;
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }
  .view-btn:hover .view-btn__arrow { transform: translateX(5px); }

  .card__cover { display: block; width: 450px; height: 370.588px; flex-shrink: 0; overflow: hidden; }
  .card__cover img {
    width: 450px;
    height: 370.588px;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  .card__cover:hover img { transform: scale(1.03); }

  /* --- Responsive: stack text over cover on narrow screens -------------- */
  @media (max-width: 860px) {
    .card, .card--reverse {
      flex-direction: column;
      height: auto;
      gap: 24px;
      align-items: flex-start;
    }
    .card__content { width: 100%; }
    .card__cover { width: 100%; height: auto; aspect-ratio: 450 / 371; }
    .card__cover img { width: 100%; height: 100%; }
    .card__title { font-size: clamp(28px, 5vw, 40px); }
  }
</style>
