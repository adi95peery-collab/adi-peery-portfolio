---
// Baby Boost — Impact (real HTML). Figma: 198:43562.
import { withBase } from '../../lib/base';
---
<section class="bb-im" data-fidelity="bb-impact">
  <div class="bb-im__content">
    <div class="bb-im__text">
      <h2 class="bb-im__title">Impact</h2>
      <div class="bb-im__body">
        <p>Baby Boost creates a personalized developmental experience that adapts to each child’s needs.</p>
        <p>Through guided activities, progress tracking, and supportive content, parents can better understand their child’s growth while building stronger daily engagement through play.</p>
      </div>
    </div>
    <a class="bb-im__back" href={withBase('/')}>
      <svg class="bb-im__arrow" viewBox="0 0 16.254 12.503" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <g fill="#5A6573">
          <path d="M10 12.503a.626.626 0 0 1-.444-1.07l5.188-5.18L9.556 1.07a.628.628 0 0 1 .888-.887l5.625 5.625a.626.626 0 0 1 0 .887l-5.625 5.625a.63.63 0 0 1-.444.182"/>
          <path d="M15.625 6.878h-15a.625.625 0 0 1 0-1.25h15a.625.625 0 1 1 0 1.25"/>
        </g>
      </svg>
      <span>Back to Home</span>
    </a>
  </div>
  <div class="bb-im__icons">
    <img src={withBase('/assets/baby-boost/parts/impact-icons.png')} width="225" height="245" alt="" aria-hidden="true" />
  </div>
</section>

<style>
  .bb-im { display: flex; align-items: flex-start; justify-content: space-between; padding: 75.039px 100px; min-height: 361.09px; background: #fff; overflow: hidden; }
  .bb-im__content { width: 723.375px; flex-shrink: 0; display: flex; flex-direction: column; gap: 32px; }
  .bb-im__text { display: flex; flex-direction: column; gap: 18.009px; }
  .bb-im__title { font-family: var(--font-sf); font-weight: 700; font-size: 45.023px; line-height: 1.19; color: #191e76; }
  .bb-im__body { display: flex; flex-direction: column; gap: 1em; }
  .bb-im__body p { font-family: var(--font-sf); font-weight: 400; font-size: 18.009px; line-height: 1.5; color: #000; }
  .bb-im__back { display: inline-flex; align-items: center; gap: 4px; padding-bottom: 4px; border-bottom: 1.5px solid var(--color-grey); color: var(--color-grey); font-size: 18px; width: fit-content; transition: gap 0.2s ease; }
  .bb-im__back:hover { gap: 8px; }
  .bb-im__arrow { width: 16.25px; height: 12.5px; transform: rotate(180deg); flex-shrink: 0; }
  .bb-im__icons { flex-shrink: 0; }
  .bb-im__icons img { width: 225px; height: 245px; display: block; }
  @media (max-width: 1040px) {
    .bb-im { padding: 56px clamp(20px,5vw,100px); gap: 32px; }
    .bb-im__content { width: 100%; }
    .bb-im__title { font-size: clamp(30px,5vw,45px); }
  }
</style>
