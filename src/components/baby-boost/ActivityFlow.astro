---
// Baby Boost — Guided Activity Experience (real HTML). Previously a flat
// screenshot of a phone mockup (bezel + background) baked into
// 04b-workflow01.png; now the actual screen-recorded demo plays inline,
// cropped to just the phone mockup itself — bezel and rounded corners kept,
// only the black recording backdrop around the device removed.
import { withBase } from '../../lib/base';
---
<section class="bb-af" data-fidelity="bb-activity-flow">
  <div class="bb-af__frame">
    <video
      class="bb-af__video"
      src={withBase('/assets/baby-boost/activities/activity-flow.mp4')}
      autoplay
      muted
      playsinline
      preload="auto"
      aria-label="Screen recording: completing a guided activity and logging the moment"
    />
  </div>
  <div class="bb-af__text">
    <h2 class="bb-af__title">Guided Activity Experience</h2>
    <p class="bb-af__body">The activity experience was designed to support parents before, during, and after each exercise through <strong>structured guidance</strong>, distraction-free interaction, and <strong>integrated moment documentation</strong>.</p>
    <p class="bb-af__tags">Guided Practice &bull; Activity Documentation &bull; Parent-Child Engagement</p>
  </div>
</section>

<script>
  // The source recording opens with ~1.7s of the phone mockup zooming/settling
  // into place, during which our hand-measured bezel crop doesn't line up.
  // Skip that intro on load and every loop instead of trimming the file.
  // Looping via `timeupdate` (jumping back just before the true end) rather
  // than the native `loop` attribute or an `ended` listener — both can show
  // a stale/black decoder frame right at the end-of-stream boundary, which
  // read as a bad crop for a split second.
  const STABLE_START = 1.7;
  const LOOP_MARGIN = 0.15;
  document.querySelectorAll<HTMLVideoElement>('.bb-af__video').forEach((video) => {
    const start = () => { video.currentTime = STABLE_START; };
    if (video.readyState >= 1) start();
    else video.addEventListener('loadedmetadata', start, { once: true });
    video.addEventListener('timeupdate', () => {
      if (video.duration && video.currentTime >= video.duration - LOOP_MARGIN) {
        video.currentTime = STABLE_START;
      }
    });
    // Seeking to an unbuffered position can leave the video paused instead
    // of continuing playback — calling play() right after setting
    // currentTime doesn't survive the async seek, so resume once it
    // actually lands instead.
    video.addEventListener('seeked', () => {
      if (video.paused) video.play();
    });
  });
</script>

<style>
  .bb-af {
    display: flex;
    align-items: center;
    gap: 150px;
    /* Top padding is 0, not 75.039, because Personalized Daily Journey (the
       previous section) already contributes its own 75.039px bottom padding
       — carrying both would double the visible gap to ~150px. */
    padding: 0 100px 75.039px;
    background: #fff;
  }
  .bb-af__frame {
    position: relative;
    flex-shrink: 0;
    width: 220px;
    /* Lines the phone up with Personalized Daily Journey's text column above
       it (measured at the page's 1440px design width), same treatment as
       Moments Documentation/Library below. */
    margin-left: 50.074px;
    /* Matches the phone's own bezel-stroke crop below (393 x 852 of the
       1920x1080 source), not the square white card behind it in the
       recording. */
    aspect-ratio: 393 / 852;
    border-radius: 20px;
    overflow: hidden;
    background: #fff;
  }
  .bb-af__video {
    /* The recording was captured with the phone mockup sitting on a white
       square card, itself sitting on a black backdrop — sized/positioned by
       hand to crop to just the device's own dark bezel stroke (at
       x:777-1170, y:132-984 out of 1920x1080), dropping both the black
       backdrop and the white card around it. The global
       `video { max-width: 100%; height: auto }` reset would otherwise clamp
       this back down and break the crop math. */
    position: absolute;
    display: block;
    max-width: none;
    width: 488.55%;
    height: 126.76%;
    left: -197.71%;
    top: -15.49%;
  }
  .bb-af__text {
    width: 475.75px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 9.005px;
  }
  .bb-af__title {
    font-family: var(--font-sf);
    font-weight: 700;
    font-size: 30px;
    line-height: 1.2;
    color: #191e76;
  }
  .bb-af__body {
    font-family: var(--font-sf);
    font-weight: 400;
    font-size: 20.25px;
    line-height: 1.3;
    color: #000;
  }
  .bb-af__body strong { font-weight: 700; }
  .bb-af__tags {
    font-family: var(--font-sf);
    font-weight: 400;
    font-size: 15.75px;
    line-height: 1.5;
    color: #072281;
  }

  @media (max-width: 900px) {
    .bb-af { flex-direction: column; align-items: flex-start; padding: 56px clamp(20px, 5vw, 100px); gap: 32px; }
    .bb-af__text { max-width: 100%; }
    .bb-af__frame { margin-left: 0; }
  }
</style>
