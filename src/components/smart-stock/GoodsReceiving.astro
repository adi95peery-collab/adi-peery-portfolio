---
// Smart Stock — Smart Goods Receiving (real HTML heading + video embed).
// The flat export's own "Smart Goods Receiving" heading/body text has been
// cropped off (05f-app-card.png starts right at the card) and rebuilt as
// real HTML below, matching the type styles already established for this
// exact pattern elsewhere on the page (Wireframes.astro's title/body).
// Video treatment is unchanged from before: the source clip is a
// transparent-background WebM of just the iPhone itself (bezel included,
// real alpha channel — verified in-browser: corners decode to alpha 0, body
// to alpha 255). Since the clip carries its own rounded-corner mask, the
// flat image's static phone can't just be covered by an opaque crop like
// Workflow01/02 — it's erased first with a solid rect matching the card's
// own blue (#ebf2ff, used elsewhere: Wireframes.astro, Baby Boost's
// Library/PersonalizedJourney), then the video is laid on top at the same
// spot so its transparent edges blend into that same blue rather than
// exposing the old static phone underneath.
import { withBase } from '../../lib/base';

const A = withBase('/assets/smart-stock');
const V = withBase('/assets/smart-stock/video');
const DESIGN_WIDTH = 1440;
const DESIGN_HEIGHT = 634.5;
---
<section class="ss-gr" data-fidelity="ss-goods-receiving" data-reveal>
  <div class="ss-gr__text">
    <h2 class="ss-gr__title">Smart Goods Receiving</h2>
    <p class="ss-gr__body">A fast and intuitive receiving flow that allows staff to scan invoices or delivery notes, automatically update inventory levels, and confirm incoming stock — reducing manual entry, errors, and processing time.</p>
  </div>
  <div class="ss-gr__frame">
    <img class="ss-gr__image" src={`${A}/05f-app-card.png`} width={DESIGN_WIDTH} height={DESIGN_HEIGHT} style={`aspect-ratio: ${DESIGN_WIDTH} / ${DESIGN_HEIGHT};`} alt="A phone showing the Smart Goods Receiving screen, with today's incoming shipments and their status." loading="lazy" decoding="async" />
    <div class="ss-gr__erase" aria-hidden="true"></div>
    <video
      class="ss-gr__video"
      src={`${V}/goods-receiving-phone.webm`}
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-label="Screen recording: scanning a delivery and confirming incoming stock in Smart Stock"
    />
  </div>
</section>

<style>
  .ss-gr {
    display: flex;
    flex-direction: column;
    gap: 46px;
    padding: 75.039px 100px 0;
    background: #fff;
  }
  .ss-gr__text {
    max-width: 675.352px;
    display: flex;
    flex-direction: column;
    gap: 9.005px;
  }
  .ss-gr__title {
    font-family: var(--font-sf);
    font-weight: 700;
    font-size: 30px;
    line-height: 1.19;
    color: #311976;
  }
  .ss-gr__body {
    font-family: var(--font-sf);
    font-weight: 400;
    font-size: 18px;
    line-height: 1.3;
    color: #000;
  }
  .ss-gr__frame {
    position: relative;
    width: 100%;
  }
  .ss-gr__image {
    width: 100%;
    height: auto;
    display: block;
  }
  .ss-gr__erase {
    /* Covers the flat image's own static phone mockup so the video's
       transparent (rounded-corner) pixels reveal this instead of it. */
    position: absolute;
    left: 41.806%;
    top: 6.304%;
    width: 16.354%;
    height: 75.571%;
    background: #ebf2ff;
  }
  .ss-gr__video {
    position: absolute;
    left: 42.083%;
    top: 6.935%;
    width: 15.799%;
    height: 74.232%;
    display: block;
  }

  @media (max-width: 1040px) {
    .ss-gr { padding: 56px clamp(20px, 5vw, 100px) 0; }
    .ss-gr__text { max-width: 100%; }
  }
</style>
