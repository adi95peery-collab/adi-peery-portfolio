---
// Baby Boost case study. Figma: Baby Boost Viewport 198:27241 (1440×14992).
// Site nav header + contiguous image-exact sections + footer.
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CaseStudySection from '../../components/CaseStudySection.astro';
import Overview from '../../components/baby-boost/Overview.astro';
import Onboarding from '../../components/baby-boost/Onboarding.astro';
import PersonalizedJourney from '../../components/baby-boost/PersonalizedJourney.astro';
import ActivityFlow from '../../components/baby-boost/ActivityFlow.astro';
import GrowthJourney from '../../components/baby-boost/GrowthJourney.astro';
import MomentsDocumentation from '../../components/baby-boost/MomentsDocumentation.astro';
import Library from '../../components/baby-boost/Library.astro';
import Impact from '../../components/baby-boost/Impact.astro';
import { withBase } from '../../lib/base';

const A = withBase('/assets/baby-boost');
const hero: [string, string, number] = [`${A}/01-hero.png`, 'Baby Boost — a parenting app, hero', 655.32];
// Visual-dominant sections kept as exact images (app screens + illustrations).
// 04b-workflow01.png (the old "Adaptive Onboarding Experience" + "Guided
// activity experience" flat image) has been fully replaced by the real
// <Onboarding /> and <ActivityFlow /> components below.
const beforeOnboarding: [string, string, number][] = [
  [`${A}/03-research.png`, 'Research and ideation', 2135.94],
  [`${A}/04a-wireframes.png`, 'Wireframes for the core flows', 1049.07],
];
const afterJourney: [string, string, number][] = [
  // 04d-beyond.png used to continue into the "Moments documentation" and
  // "Parenting support library" sections baked into the flat image; both are
  // cropped off here since they're now rebuilt as real <MomentsDocumentation
  // /> and <Library /> components below (keeping the flat versions too was
  // showing every duplicated). 04c-journey.png is rendered by <GrowthJourney
  // /> above, unmodified, with just a scrollable overlay dropped onto its
  // phone's map area.
  [`${A}/04d-beyond.png`, 'Beyond the activity', 982.5],
];
const afterLibrary: [string, string, number][] = [
  [`${A}/04e-ai-collab.png`, 'AI collaboration and the illustration system', 3434.22],
];
---

<Base title="Baby Boost — Case Study · Adi Peery" description="Baby Boost — a parenting app that turns everyday moments into guided developmental activities. A case study by Adi Peery.">
  <Header active="work" />

  <div class="page">
    <main class="case-study">
      <h1 class="sr-only">Baby Boost — a parenting app</h1>
      <CaseStudySection src={hero[0]} alt={hero[1]} height={hero[2]} eager={true} />
      <Overview />
      {beforeOnboarding.map(([src, alt, h]) => (
        <CaseStudySection src={src} alt={alt} height={h} />
      ))}
      <Onboarding />
      <PersonalizedJourney />
      <ActivityFlow />
      <GrowthJourney />
      {afterJourney.map(([src, alt, h]) => (
        <CaseStudySection src={src} alt={alt} height={h} />
      ))}
      <MomentsDocumentation />
      <Library />
      {afterLibrary.map(([src, alt, h]) => (
        <CaseStudySection src={src} alt={alt} height={h} />
      ))}
      <Impact />
    </main>
  </div>

  <Footer />
</Base>

<style>
  .page {
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
    background: var(--color-bg-white);
    overflow-x: clip;
  }
</style>
