---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/base';
---

<Base title="Page not found — Adi Peery">
  <Header active="work" />
  <div class="page">
    <main class="nf">
      <p class="nf__code">404</p>
      <h1 class="nf__title">This page wandered off.</h1>
      <p class="nf__sub">The page you’re looking for doesn’t exist.</p>
      <a class="nf__link" href={withBase('/')}>← Back to Home</a>
    </main>
  </div>
  <Footer />
</Base>

<style>
  .page { width: 100%; max-width: 1440px; margin-inline: auto; background: var(--color-bg-white); overflow-x: clip; }
  .nf {
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 12px;
    padding: 80px 24px;
  }
  .nf__code { font-weight: 700; font-size: 20px; letter-spacing: 1.2px; color: var(--color-accent); }
  .nf__title { font-weight: 700; font-size: clamp(32px, 5vw, 58px); letter-spacing: -1px; color: var(--color-text-primary); }
  .nf__sub { font-size: 18px; color: var(--color-text-secondary); }
  .nf__link {
    margin-top: 16px; font-size: 18px; color: var(--color-grey);
    padding-bottom: 3px; border-bottom: 1.5px solid var(--color-grey);
  }
</style>
