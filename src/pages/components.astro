---
// Components / Style Guide. Figma: Components section 126:18139 (content 1847×1471).
// An internal design-system board (icons, buttons, logo/nav/footer variants),
// presented as a pixel-exact image on the design's grey canvas.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/base';
---

<Base title="Components & Style Guide — Adi Peery" description="Design system and component library for the Adi Peery portfolio.">
  <div class="sg">
    <Header active="work" />
    <main class="sg__main">
      <div class="sg__intro">
        <p class="sg__eyebrow">DESIGN SYSTEM</p>
        <h1 class="sg__title">Components &amp; Style Guide</h1>
      </div>
      <div class="sg__board">
        <img
          data-fidelity="components-board"
          src={withBase('/assets/components-board.png')}
          alt="Component library: buttons, arrows, logo, navigation and footer variants"
          width="1847"
          height="1471"
          decoding="async"
        />
      </div>
    </main>
    <Footer />
  </div>
</Base>

<style>
  .sg { background: var(--color-bg-page); min-height: 100vh; }
  .sg__main { padding: 64px clamp(20px, 5vw, 100px) 80px; }
  .sg__intro { max-width: 1240px; margin: 0 auto 40px; }
  .sg__eyebrow {
    font-weight: 600; font-size: 12px; line-height: 1.3;
    letter-spacing: 1.2px; color: var(--color-accent);
  }
  .sg__title {
    font-weight: 600; font-size: 40px; line-height: 1.15;
    letter-spacing: -0.5px; color: var(--color-text-primary); margin-top: 8px;
  }
  .sg__board { display: flex; justify-content: center; }
  .sg__board img {
    width: 1847px;
    max-width: 100%;
    height: auto;
    display: block;
  }
</style>
